# Твой личный Telegram ID для команды create_admin.
ADMIN_TG_ID=PASTE_HERE
MANAGERS_CHAT_ID=
LAWYER_TG_ID=
BOT_BRIDGE_SECRET=
UNISENDER_GO_API_KEY=
# Preferred universal routing host. Override with go1/go2 only when this account's data center requires it.
UNISENDER_GO_BASE_URL=https://goapi.unisender.ru/ru/transactional/api/v1
UNISENDER_FROM_EMAIL=
MINIMAX_API_KEY=
MINIMAX_MODEL=
