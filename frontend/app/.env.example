# Для production build обязательно укажите публичный nginx API, не localhost и не порт 8001.
VITE_API_URL=https://mir.pod-solncem.ru/api/v1
# Username Auth-бота для Telegram Login Widget, без символа @.
# Этот бот привязан через /setdomain к mir.pod-solncem.ru.
VITE_TELEGRAM_BOT_USERNAME=Reg_Under_the_sun_bot
